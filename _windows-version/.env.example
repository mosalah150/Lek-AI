# คัดลอกเป็น .env แล้วแก้ค่า:  Copy-Item .env.example .env
# อย่า commit หรือส่งไฟล์ .env ให้ใคร
# สร้างค่าสุ่มใน PowerShell (รันทีละค่า):
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | % { $_.ToString('x2') })

# URL ของ Tailscale Serve เช่น https://ai-server.tail1234.ts.net
WEBUI_URL=

WEBUI_SECRET_KEY=
POSTGRES_PASSWORD=

# สำคัญ: ถ้าหาย credential ทั้งหมดใน n8n จะใช้ไม่ได้ ให้จดเก็บไว้ที่ปลอดภัย
N8N_ENCRYPTION_KEY=
